---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { CommandPalette } from '../components/CommandPalette';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { FlagshipSection } from '../components/FlagshipSection';
import Workshop from '../components/Workshop.astro';
import { Experience } from '../components/Experience';
import Community from '../components/Community.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { flagships } from '../data/flagships';
import { skills } from '../data/skills';
---

<Base>
  <Nav client:load />
  <CommandPalette client:idle />

  <main class="min-h-screen max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-24 flex flex-col gap-12 sm:gap-16">
    {/* Hero Section with Live Telemetry */}
    <Hero />

    {/* Verified Engineering Proof Strip */}
    <ProofStrip />

    {/* Section 1: Professional Experience & Leadership */}
    <section id="experience" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent)] mb-3">
          <span>// 01</span>
          <span>PROFESSIONAL EXPERIENCE</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
          Engineering Leadership &amp; Track Record
        </h2>
        <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
          Leading industrial software architecture, on-premises applied AI, resilient infrastructure, and enterprise execution.
        </p>
      </div>

      <Experience client:visible />
    </section>

    {/* Section 2: Selected Open-Source Work & Case Studies */}
    <section id="work" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent-2)] mb-3">
            <span>// 02</span>
            <span>OPEN-SOURCE FLAGSHIPS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
            Open-Source Tools &amp; Applied AI
          </h2>
          <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
            Independently built and maintained developer utilities, agent skills, and privacy-preserving AI engines.
          </p>
        </div>
      </div>

      <FlagshipSection flagships={flagships} client:load />
    </section>

    {/* Workshop: Experiments & Open Source */}
    <Workshop />

    {/* Section 3: Technical Skills & Protocols */}
    <section id="skills" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--text)] mb-3">
          <span>// 03</span>
          <span>TECHNICAL ARSENAL</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
          Systems &amp; Stack
        </h2>
        <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
          Core competencies across languages, real-time telemetry protocols, and automated drawing extraction.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {skills.map((group) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 space-y-3">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--accent)]">
              {group.title}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {group.skills.filter((item) => !item.name.toLowerCase().includes('todo')).map((item) => (
                <span
                  class={`text-xs px-2.5 py-1 rounded-full font-mono ${
                    item.highlight
                      ? 'bg-[var(--accent-muted)] border border-[var(--accent)]/40 text-[var(--accent)] font-medium'
                      : 'bg-black/30 border border-white/5 text-[var(--muted)]'
                  }`}
                >
                  {item.name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Community Section (Conditionally rendered) */}
    <Community />

    {/* Section 4: Contact & Engagement */}
    <Contact />

    {/* Footer with Attribution & Smooth Back-to-Top */}
    <Footer />
  </main>
</Base>
