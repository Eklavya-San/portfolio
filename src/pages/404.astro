---
import Base from '../layouts/Base.astro';
import { Nav } from '../components/Nav';
import { CommandPalette } from '../components/CommandPalette';
import { ArrowLeft, Compass, Terminal } from 'lucide-react';
---

<Base
  title="404: Signal Lost | Eklavya Ghodake — claudya.in"
  description="The requested telemetry route does not exist in cluster claudya.in. Return to system dashboard."
>
  <Nav client:load />
  <CommandPalette client:idle />

  <main class="min-h-[80vh] max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 flex items-center justify-center">
    <div class="w-full max-w-xl text-center space-y-8">
      {/* 404 Monospace Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent)] shadow-sm">
        <span class="w-2 h-2 rounded-full bg-red-400 animate-ping"></span>
        <span class="font-semibold text-red-400">404</span>
        <span class="text-[var(--muted-dark)]">//</span>
        <span>SIGNAL LOST</span>
      </div>

      {/* Main Heading */}
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--text)]">
          Telemetry Route Unreachable
        </h1>
        <p class="text-sm sm:text-base text-[var(--muted)] max-w-md mx-auto leading-relaxed">
          The requested coordinate does not exist or has been decommissioned from the <code class="px-1.5 py-0.5 rounded bg-[var(--surface-elevated)] text-[var(--accent)] font-mono text-xs">claudya.in</code> topology.
        </p>
      </div>

      {/* Diagnostic Terminal Card */}
      <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface)] text-left font-mono text-xs text-[var(--muted)] space-y-2">
        <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-2 text-[var(--muted-dark)]">
          <div class="flex items-center gap-2">
            <Terminal className="w-3.5 h-3.5 text-[var(--accent)]" />
            <span>DIAGNOSTIC_TRACE</span>
          </div>
          <span>STATUS: 404_NOT_FOUND</span>
        </div>
        <div class="text-[var(--text)] pt-1">
          <span class="text-red-400">ERR_NODE_ABSENT:</span> Path resolution returned NULL for current ingress.
        </div>
        <div class="text-[var(--muted-dark)]">
          &gt; trace --cluster edge.claudya.in --fallback true
        </div>
      </div>

      {/* Action Buttons */}
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-[var(--accent)] text-black hover:bg-[var(--accent-hover)] transition-all shadow-sm active:scale-95"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>Return Home</span>
        </a>

        <a
          href="/#work"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-medium border border-[var(--border)] bg-[var(--surface-elevated)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all active:scale-95"
        >
          <Compass className="w-3.5 h-3.5" />
          <span>Explore Flagships</span>
        </a>
      </div>
    </div>
  </main>

  <footer class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--muted)]">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
      <a href="/" class="text-[var(--text)] font-semibold hover:text-[var(--accent)] transition-colors">
        claudya.in
      </a>
      <span class="text-[var(--muted-dark)]">•</span>
      <span>© 2026 Eklavya Ghodake</span>
    </div>
    <div class="text-[var(--muted-dark)] text-center sm:text-right">
      Obsidian Capsule System • Pune, India
    </div>
  </footer>
</Base>
