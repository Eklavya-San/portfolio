---
import { profile } from '../data/profile';
import { checkYoutubeConfirmed } from '../lib/community';

interface Props {
  forceShow?: boolean;
}

const { forceShow = false } = Astro.props;

const isYoutubeConfirmed = forceShow || checkYoutubeConfirmed(profile);
---

{isYoutubeConfirmed && (
  <section id="community" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent-2)] mb-3">
          <span>// COMMUNITY</span>
          <span>VIDEO TUTORIALS &amp; SHARING</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
          Knowledge Sharing &amp; Deep Dives
        </h2>
        <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
          Walkthroughs of industrial protocols, agentic workflows, and distributed systems on YouTube.
        </p>
      </div>
    </div>

    <div class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl relative overflow-hidden group">
      <div class="space-y-2 text-center md:text-left z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-red-500/10 border border-red-500/30 text-red-400">
          <svg class="w-3.5 h-3.5 fill-red-400 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>YouTube Channel</span>
        </div>
        <h3 class="text-xl font-bold text-[var(--text)]">@developer_by_choice</h3>
        <p class="text-sm text-[var(--muted)] max-w-md">
          Industrial IoT streaming, MQTT debugging in Go, and practical AI agent skills for developers.
        </p>
      </div>

      <a
        href={profile.links.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-red-600 hover:bg-red-500 text-white transition-colors shadow-md shrink-0 z-10"
        aria-label="Visit YouTube channel @developer_by_choice (opens in new tab)"
      >
        <span>Watch on YouTube</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>
)}
