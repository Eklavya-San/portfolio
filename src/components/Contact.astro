---
import { profile } from '../data/profile';
import { ContactTerminal } from './ContactTerminal';

// Clean verified links
const emailHref = profile.links.email || 'mailto:eklavyaghodake@gmail.com';
const emailAddress = emailHref.replace('mailto:', '');
const githubHref = profile.links.github || 'https://github.com/Eklavya-San';
const xHref = profile.links.x || 'https://x.com/eghodake';
const linkedinHref =
  profile.links.linkedin && !profile.links.linkedin.startsWith('TODO')
    ? profile.links.linkedin
    : 'https://www.linkedin.com/in/eklavya-ghodake';
---

<section id="contact" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent)] mb-3">
        <span>// 06</span>
        <span>HANDSHAKE PROTOCOL</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
        Initiate Contact &amp; Engagement
      </h2>
      <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
        Whether you want to discuss distributed architectures, industrial IoT telemetry, or applied AI engineering—my terminal and inbox are open.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    {/* Left Column: Interactive Contact Terminal */}
    <div class="lg:col-span-7">
      <ContactTerminal
        client:idle
        email={emailAddress}
        phone="+91 77219 01494"
        location="Maharashtra, India"
      />
    </div>

    {/* Right Column: Handshake Action Card */}
    <div class="lg:col-span-5">
      <div class="brk rounded-2xl border border-[var(--border)] bg-[var(--surface)]/95 p-6 sm:p-7 space-y-6 shadow-xl relative overflow-hidden group">
        <!-- Ambient subtle background glow -->
        <div
          class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-[var(--accent-muted)] rounded-full blur-3xl opacity-30"
          aria-hidden="true"
        ></div>

        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-black/40 text-[var(--accent)] relative z-10">
          <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse shadow-[0_0_8px_var(--accent)]"></span>
          <span>ESTABLISH CONNECTION</span>
        </div>

        <!-- Headline & Copy -->
        <div class="space-y-2 relative z-10">
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text)]">
            Open for Engineering Leadership
          </h3>
          <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
            Leading high-throughput distributed microservices, factory-floor streaming pipelines, and event-driven architectures.
          </p>
        </div>

        <!-- Primary Actions: Email & Résumé -->
        <div class="pt-1 flex flex-col gap-2.5 relative z-10">
          <a
            href={emailHref}
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-[var(--accent)] text-black hover:bg-[var(--accent-hover)] transition-all shadow-lg shadow-[var(--accent)]/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
            aria-label={`Send email to ${emailAddress}`}
          >
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{emailAddress}</span>
            <svg class="w-4 h-4 ml-0.5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/Eklavya_Ghodake_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-medium border border-[var(--border)] bg-[var(--surface-hover)] text-[var(--text)] hover:border-[var(--accent)] hover:text-white transition-colors"
            aria-label="Download Résumé PDF (opens in new tab)"
          >
            <svg class="w-4 h-4 text-[var(--muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download Résumé</span>
          </a>
        </div>

        <!-- Secondary Social Connectors -->
        <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center gap-2 text-xs font-mono relative z-10">
          <a
            href={githubHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--border)] bg-black/30 text-[var(--muted)] hover:text-white hover:border-[var(--border-focus)] transition-colors"
            aria-label="GitHub profile (opens in new tab)"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>

          <a
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--border)] bg-black/30 text-[var(--muted)] hover:text-white hover:border-[var(--border-focus)] transition-colors"
            aria-label="LinkedIn profile (opens in new tab)"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.32a1.64 1.64 0 0 0-1.64 1.64c0 .91.73 1.64 1.64 1.64.91 0 1.64-.73 1.64-1.64 0-.91-.73-1.64-1.64-1.64z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a
            href={xHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--border)] bg-black/30 text-[var(--muted)] hover:text-white hover:border-[var(--border-focus)] transition-colors"
            aria-label="X / Twitter profile (opens in new tab)"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
