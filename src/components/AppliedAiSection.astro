---
---

<section id="applied-ai" class="scroll-mt-24 pt-10 border-t border-[var(--border-subtle)] space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono border border-[var(--border)] bg-[var(--surface)] text-[var(--accent)] mb-3">
        <span>// 03</span>
        <span>APPLIED AI IN PRACTICE</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
        AI that fits the real-world workflow.
      </h2>
      <p class="text-sm text-[var(--muted)] mt-1.5 max-w-xl">
        Grounded in practical engineering: making industrial manuals searchable, running models locally, and turning unstructured drawings into validated structure.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {/* Capability 1: Industrial manual RAG */}
    <article class="brk rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 space-y-4 shadow-sm hover:shadow-md hover:border-[var(--accent)]/50 transition-all">
      <div class="w-10 h-10 rounded-xl bg-[#20332d] text-[#c8f169] flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 4h14v16H5zM8 8h8M8 12h5" />
          <path d="m15 16 2 2 4-4" />
        </svg>
      </div>
      <div class="space-y-1.5">
        <h3 class="text-lg font-bold text-[var(--text)]">Industrial manual RAG</h3>
        <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
          Retrieval-augmented chat system for querying industrial equipment manuals, connecting language-model responses directly to source documentation with zero external egress.
        </p>
      </div>
      <div class="flex flex-wrap gap-1.5 pt-2 font-mono text-[10px] text-[var(--muted)]">
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Vector Search</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Local LLMs</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Air-Gapped</span>
      </div>
    </article>

    {/* Capability 2: Local model inference */}
    <article class="brk rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 space-y-4 shadow-sm hover:shadow-md hover:border-[var(--accent)]/50 transition-all">
      <div class="w-10 h-10 rounded-xl bg-[#20332d] text-[#c8f169] flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="4" width="16" height="16" rx="3" />
          <path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3" />
        </svg>
      </div>
      <div class="space-y-1.5">
        <h3 class="text-lg font-bold text-[var(--text)]">Local model inference</h3>
        <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
          Optimized inference workflows using Ollama and llama.cpp on edge hardware and local clusters, guaranteeing tight enterprise data boundary compliance.
        </p>
      </div>
      <div class="flex flex-wrap gap-1.5 pt-2 font-mono text-[10px] text-[var(--muted)]">
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Ollama</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">llama.cpp</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Edge Compute</span>
      </div>
    </article>

    {/* Capability 3: LLM-based CTQ extraction */}
    <article class="brk rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 space-y-4 shadow-sm hover:shadow-md hover:border-[var(--accent)]/50 transition-all">
      <div class="w-10 h-10 rounded-xl bg-[#20332d] text-[#c8f169] flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16v16H4zM8 8h8M8 12h4M8 16h6" />
          <circle cx="17" cy="16" r="2" />
        </svg>
      </div>
      <div class="space-y-1.5">
        <h3 class="text-lg font-bold text-[var(--text)]">LLM-based CTQ extraction</h3>
        <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
          Multimodal agent pipeline extracting Critical-To-Quality tolerances and 14 ASME Y14.5 / ISO 1101 GD&amp;T symbols from engineering drawings into JSON schemas.
        </p>
      </div>
      <div class="flex flex-wrap gap-1.5 pt-2 font-mono text-[10px] text-[var(--muted)]">
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">Multimodal LLM</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">GD&amp;T Symbols</span>
        <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">JSON Schema</span>
      </div>
    </article>
  </div>
</section>
