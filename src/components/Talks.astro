---
import { talks } from '../data/experience';
---

<div class="space-y-4">
  <div class="flex items-center gap-2">
    <div class="w-2 h-2 rounded-full bg-[var(--accent-2)]"></div>
    <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--accent-2)]">
      Conference &amp; Industry Presentations
    </h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {talks.map((talk) => (
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 space-y-3 relative overflow-hidden group hover:border-[var(--border-focus)] transition-colors">
        <div class="flex items-start justify-between gap-3">
          <div class="space-y-1">
            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-mono bg-[var(--accent-2-muted)] text-[var(--accent-2)] border border-[var(--accent-2)]/30">
              {talk.event}
            </span>
            <h4 class="text-sm font-bold text-[var(--text)] group-hover:text-white transition-colors">
              {talk.title}
            </h4>
          </div>
          <span class="text-xs font-mono text-[var(--muted-dark)] shrink-0 px-2 py-0.5 rounded bg-black/40 border border-white/5">
            {talk.year}
          </span>
        </div>

        <p class="text-xs text-[var(--muted)] leading-relaxed">
          {talk.description}
        </p>

        {talk.tags && talk.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {talk.tags.map((tag) => (
              <span class="text-[10px] px-2 py-0.5 rounded-full font-mono bg-black/40 border border-white/5 text-[var(--muted)]">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</div>
