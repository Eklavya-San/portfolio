---
import type { WorkshopCard as WorkshopCardType } from '../types/portfolio';

interface Props {
  project: WorkshopCardType;
}

const { project } = Astro.props;
const repoUrl = project.repoUrl || `https://github.com/Eklavya-San/${project.repo}`;
---

<div
  class="workshop-card brk group relative flex flex-col justify-between rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 transition-all duration-300 hover:border-[var(--accent)]/50 overflow-hidden"
  style="--mx: -9999px; --my: -9999px;"
  data-repo={project.repo}
>
  <!-- Pointer-follow glow overlay (UX #8) -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-0"
    style="background: radial-gradient(400px circle at var(--mx) var(--my), rgba(16, 185, 129, 0.12), transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 space-y-4">
    <!-- Top row: Repo Title & Outbound GitHub Link + Star Count if any -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[var(--accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <h3 class="font-mono text-base font-bold text-[var(--text)] group-hover:text-white transition-colors">
          {project.title}
        </h3>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        {project.stars !== undefined && project.stars > 0 && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-mono bg-white/5 border border-white/10 text-[var(--muted)]">
            <svg class="w-3 h-3 text-amber-400 fill-amber-400" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span>{project.stars}</span>
          </span>
        )}
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-full text-[var(--muted)] hover:text-white hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
          aria-label={`View ${project.title} repository on GitHub (opens in new tab)`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Tagline -->
    <p class="text-sm text-[var(--muted)] leading-relaxed">
      {project.tagline}
    </p>

    <!-- Domain Tags & Stack pills -->
    <div class="flex flex-wrap gap-1.5 pt-1">
      {project.tags.map((tag) => (
        <span class="text-[11px] px-2 py-0.5 rounded-full font-mono bg-[var(--accent-muted)] border border-[var(--accent)]/30 text-[var(--accent)]">
          {tag}
        </span>
      ))}
      {project.stack.filter((item) => !project.tags.includes(item)).map((item) => (
        <span class="text-[11px] px-2 py-0.5 rounded-full font-mono bg-black/40 border border-white/5 text-[var(--muted)]">
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="relative z-10 pt-5 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-mono">
    {project.language ? (
      <span class="inline-flex items-center gap-1.5 text-[var(--muted-dark)]">
        <span class="w-2 h-2 rounded-full bg-[var(--accent-2)]"></span>
        <span>{project.language}</span>
      </span>
    ) : (
      <span class="text-[var(--muted-dark)]">Open Source</span>
    )}

    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors group-hover:underline underline-offset-4"
    >
      <span>GitHub</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
